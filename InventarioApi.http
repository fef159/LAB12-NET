@host = http://localhost:5000

### 200 - Estado de la aplicación publicada
GET {{host}}/health

### 200 - Listar categorías
GET {{host}}/api/categorias
Accept: application/json

### 201 - Crear categoría
POST {{host}}/api/categorias
Content-Type: application/json

{"nombre":"Impresoras","descripcion":"Equipos de impresión"}

### 400 - Validación automática por Data Annotations
POST {{host}}/api/productos
Content-Type: application/json

{"nombre":"X","sku":"Y","precio":0,"stock":-1,"categoriaId":0}

### 404 - Recurso inexistente
GET {{host}}/api/productos/999999

### 409 - Nombre de categoría repetido
POST {{host}}/api/categorias
Content-Type: application/json

{"nombre":"Computadores","descripcion":"Duplicada"}

### 409 - No eliminar categoría con productos
DELETE {{host}}/api/categorias/1

### 204 - Actualizar producto
PUT {{host}}/api/productos/1
Content-Type: application/json

{"nombre":"Portátil empresarial actualizado","sku":"PORT-001","precio":3399000,"stock":7,"categoriaId":1}

### 204 - Eliminar producto (ajusta el id a uno existente)
DELETE {{host}}/api/productos/3
